# Build context exclusions — keep the image small.
#
# IMPORTANT: This is a multi-stage build. The builder stage needs
# package.json, package-lock.json, src/, scripts/, tailwind.config.js
# and postcss.config.js to compile Tailwind. Do NOT exclude those here.
# Only the final nginx image doesn't need them, but Docker layers
# handle that automatically.

# VCS
.git
.gitignore
.gitattributes

# Docs / editor / OS
README.md
LICENSE*
CHANGELOG*
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo
*.swn
*.log
*.tgz
*.tar.gz

# Local artifacts
.antigravitycli

# node_modules (npm ci re-creates inside the builder)
node_modules
.cache
.tmp

# Test/lint configs we don't need at build time
.eslintrc*
.prettierrc*
.github
